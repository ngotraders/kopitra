## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# NuGet Packages
*.nupkg
*.snupkg
# The packages folder can be checked in to source control using NuGet, but in the case that
# a NuGet package is restored, dependencies might not be declared right if the version pinned in
# the packages.config file is different from the version restored.
# packages/
# !**\/packages/config
# !**\/packages/build/

# Nuget personal access token and other sensitive credential files should never be checked in
credentials.json

# Local .NET Core NativeAOT build folders
artifacts/

# Entity Framework migrations
App_Data/

# Local database
*.db
*.db-shm
*.db-wal

# Azure Functions
local.settings.json
__pycache__/
bin/
obj/

# macOS
.DS_Store
