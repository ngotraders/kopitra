{
  "name": "@kopitra/opsconsole",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:integration": "vitest run --runInBand --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "format": "prettier \"**/*.{js,ts,tsx,css,md}\" --write",
    "format:check": "prettier \"**/*.{js,ts,tsx,css,md}\" --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.3",
    "date-fns": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.36.0",
    "@storybook/addon-a11y": "^9.1.13",
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/addon-vitest": "^9.1.13",
    "@storybook/react-vite": "^9.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-storybook": "^9.1.13",
    "globals": "^16.4.0",
    "jsdom": "^24.1.1",
    "playwright": "^1.56.1",
    "prettier": "^3.4.2",
    "storybook": "^9.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
